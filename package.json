{
  "name": "cygnus",
  "version": "1.2.2",
  "main": "Main.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "rimraf .expo android coverage ios",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "test": "jest",
    "e2e:prepare": "expo prebuild",
    "e2e:ios:build": "detox build --configuration ios.release",
    "e2e:ios:test": "detox test --configuration ios.release",
    "e2e:ios": "run-s e2e:ios:*",
    "e2e:android:build": "detox build --configuration android.release",
    "e2e:android:test": "detox test --configuration android.release",
    "e2e:android": "run-s e2e:android:*",
    "postinstall": "patch-package",
    "prepare": "husky install"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/gradle-plugin": "^0.81.5",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "axios": "^1.8.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lodash": "^4.17.21",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-circular-progress": "^1.4.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-location": "^5.0.0",
    "react-native-gifted-charts": "^1.4.60",
    "react-native-graph": "^1.1.0",
    "react-native-image-pan-zoom": "^2.1.12",
    "react-native-lan-port-scanner": "^1.4.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp": "github:gajjartejas/react-native-tcp",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@config-plugins/detox": "^11.0.0",
    "@expo/config-plugins": "~54.0.5",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.1.3",
    "@types/detox": "^18.1.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "detox": "^20.11.1",
    "eslint": "^8.46.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-detox": "^1.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "eslint-plugin-testing-library": "^5.11.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^13.2.3",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@expo/config-plugins"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
